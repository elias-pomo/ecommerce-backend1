<h1 class="text-center mb-4">Nuestro Catálogo Exclusivo</h1>


<div class="row g-4">
    {{#each products}}
    
    <div class="col-12 col-md-6 col-lg-4">
        
        <div class="card h-100 shadow-sm border-0">
            {{#if this.thumbnails.[0]}}
                <img src="{{this.thumbnails.[0]}}" class="card-img-top" alt="{{this.title}}" style="height: 250px; object-fit: cover;">
            {{else}}
                <img src="https://dummyimage.com/600x400/dee2e6/6c757d.jpg&text=Sin+Imagen" class="card-img-top" alt="Sin imagen" style="height: 250px; object-fit: cover;">
            {{/if}}
            <div class="card-body d-flex flex-column">
                <h5 class="card-title fw-bold">{{this.title}}</h5>
                <h6 class="card-subtitle mb-2 text-muted text-capitalize">{{this.category}}</h6>
                
                <p class="card-text text-truncate">{{this.description}}</p>
                
                <h4 class="text-success mt-auto mb-3">${{this.price}}</h4>
                
                <a href="/products/{{this._id}}" class="btn btn-dark w-100">Ver Detalles</a>
            </div>
        </div>
    </div>
    
    {{/each}}
</div>

<!-- Paginación centrada y estilizada -->
<div class="d-flex justify-content-center align-items-center mt-5">
    {{#if hasPrevPage}}
        <a href="/products?page={{prevPage}}" class="btn btn-outline-dark me-3">Anterior</a>
    {{/if}}

    <span class="badge bg-secondary fs-6 py-2 px-3">Página {{page}}</span>

    {{#if hasNextPage}}
        <a href="/products?page={{nextPage}}" class="btn btn-outline-dark ms-3">Siguiente</a>
    {{/if}}
</div>